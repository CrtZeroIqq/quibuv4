{
    "name": "quibu/quibuv4",
    "description": "Sistema de Cobranza Automatizada - Quibu V4",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "transbank/transbank-sdk": "^2.0",
        "mercadopago/dx-php": "^2.6",
        "twilio/sdk": "^7.0",
        "tecnickcom/tcpdf": "^6.6",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "files": [
            "api/conexion.php",
            "api/mp-config.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
