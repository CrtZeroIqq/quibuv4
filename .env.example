# QUIBU - Variables de Entorno
# Copiar este archivo a .env y completar con tus credenciales reales
# NUNCA subir .env a Git (ya está en .gitignore)

# ======================
# BASE DE DATOS
# ======================
DB_HOST=localhost
DB_NAME=quibu_db
DB_USER=root
DB_PASS=

# ======================
# MERCADO PAGO
# ======================
# Obtener credenciales en: https://www.mercadopago.cl/developers/panel/app

# Client ID de tu aplicación Mercado Pago
MP_CLIENT_ID=

# Client Secret de tu aplicación Mercado Pago
MP_CLIENT_SECRET=

# URL de retorno OAuth (debe estar configurada en MP)
MP_REDIRECT_URI=https://www.quibu.cl/api/mp-callback.php

# URLs de retorno después del pago
MP_SUCCESS_URL=https://www.quibu.cl/pago-exitoso.php
MP_FAILURE_URL=https://www.quibu.cl/pago-fallido.php
MP_PENDING_URL=https://www.quibu.cl/pago-pendiente.php

# URL del webhook para notificaciones
MP_WEBHOOK_URL=https://www.quibu.cl/api/mp-webhook.php

# Modo: 'sandbox' para testing, 'production' para producción
MP_MODE=sandbox

# Comisión de Quibu (porcentaje, ej: 3.5 para 3.5%)
QUIBU_COMMISSION_PERCENT=0

# ======================
# TRANSBANK
# ======================
# Credenciales de Transbank WebPay Plus

# Modo: 'integration' para testing, 'production' para producción
TRANSBANK_MODE=integration

# API Key (Integration mode)
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Commerce Code (Integration mode)
TRANSBANK_COMMERCE_CODE=597055555532

# URLs de retorno Transbank
TRANSBANK_RETURN_URL=https://www.quibu.cl/api/respuesta-pago.php

# ======================
# TWILIO (SMS)
# ======================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ======================
# GENERAL
# ======================
APP_ENV=development
APP_DEBUG=true
APP_URL=https://www.quibu.cl
